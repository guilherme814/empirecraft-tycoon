; Engine configuration file.
config_version=5

[application]

config/name="Device Empire"
config/version="0.6.1"
config/description="Simulador estratégico de gestão empresarial e tecnologia. Desenvolva dispositivos, construa seu império e domine o mercado com inovação, estratégia e visão de longo prazo."
run/main_scene="res://src/scenes/MainMenu.tscn"
config/icon="res://icon.svg"
config/quit_on_go_back=false
config/features=PackedStringArray("4.2", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.08, 0.1, 1)

[autoload]

Game="*res://src/autoload/Game.gd"
Clock="*res://src/autoload/Clock.gd"
Saves="*res://src/autoload/Saves.gd"
Sfx="*res://src/autoload/Sfx.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/android/enable_pan_and_scale_gestures=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
